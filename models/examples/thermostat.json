          "ui": {
            "x": 120,
            "y": 240
          },
          "uniflow": true
        },
        {
          "id": "heat_loss",
          "type": "flow",
          "name": "Heat Loss",
          "formula": "(room_temp - outdoor) * 0.1",
          "from": "room_temp",
          "ui": {
            "x": 600,
            "y": 240
          }
        },
        {
          "id": "note1",
          "type": "note",
          "name": "about",
          "notes": "Balancing loop demo.\nPress ▶, then drag the Setpoint or Outdoor dials and watch the system re-balance.",
          "ui": {
            "x": 320,
            "y": 40
          }
        }
      ],
      "edges": [
        {
          "id": "l1",
          "type": "link",
          "from": "setpoint",
          "to": "heating"
        },
        {
          "id": "l2",
          "type": "link",
          "from": "room_temp",
          "to": "heating"
        },
        {
          "id": "l3",
          "type": "link",
          "from": "room_temp",
          "to": "heat_loss"
        },
        {
          "id": "l4",
          "type": "link",
          "from": "outdoor",
          "to": "heat_loss"
        }
      ]
    }
  }
