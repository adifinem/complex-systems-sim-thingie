{
  "version": 1,
  "meta": {
    "name": "thermostat",
    "notes": "Balancing loop: heating fights heat loss. Drag the dials mid-run."
  },
  "sim": {
    "dt": 0.1,
    "seed": 42
  },
  "mainGraph": "main",
  "graphs": {
    "main": {
      "name": "Main",
      "nodes": [
        {
          "id": "room_temp",
          "type": "stock",
          "name": "Room Temp",
          "initial": "18",
          "ui": {
            "x": 340,
            "y": 220
          }
        },
        {
          "id": "setpoint",
          "type": "constant",
          "name": "Setpoint",
          "value": 20,
          "dial": {
            "max": 30,
            "min": 10,
            "step": 0.5
          },
          "ui": {
            "x": 80,
            "y": 80
          }
        },
        {
          "id": "outdoor",
          "type": "constant",
          "name": "Outdoor",
          "value": 5,
          "dial": {
            "max": 25,
            "min": -10,
            "step": 0.5
          },
          "ui": {
            "x": 640,
            "y": 80
          }
        },
        {
          "id": "heating",
          "type": "flow",
          "name": "Heating",
          "formula": "max(0, setpoint - room_temp) * 0.5",
